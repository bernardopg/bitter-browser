{
    "app-id": "com.bitterbrowser.Browser",
    "runtime": "org.gnome.Platform",
    "runtime-version": "51",
    "sdk": "org.gnome.Sdk",
    "sdk-extensions": [
        "org.freedesktop.Sdk.Extension.rust-stable"
    ],
    "command": "bitter-ui",
    "finish-args": [
        "--share=network",
        "--share=ipc",
        "--socket=fallback-x11",
        "--socket=wayland",
        "--device=dri",
        "--filesystem=xdg-download"
    ],
    "build-options": {
        "append-path": "/usr/lib/sdk/rust-stable/bin",
        "env": {
            "CARGO_HOME": "/run/build/bitter-browser/cargo",
            "CARGO_NET_OFFLINE": "true"
        }
    },
    "modules": [
        {
            "name": "bitter-browser",
            "buildsystem": "meson",
            "sources": [
                {
                    "type": "dir",
                    "path": "..",
                    "skip": [
                        "target",
                        "builddir",
                        "build-dir",
                        ".flatpak-builder",
                        ".git",
                        "graphify-out",
                        ".tokensave",
                        ".headroom",
                        "repo"
                    ]
                },
                "cargo-sources.json"
            ]
        }
    ]
}
