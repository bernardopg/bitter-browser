# Copy to .env (ignored by git) and fill in. The same values are GitHub
# Actions secrets of bernardopg/bitter-browser; see docs/distribution.md#secrets.
AUR_USERNAME=
AUR_EMAIL=
# Path of the SSH private key registered on the AUR account.
AUR_SSH_PRIVATE_KEY_FILE=
PACMAN_GPG_FINGERPRINT=
PACMAN_GPG_PRIVATE_KEY=""
PACMAN_GPG_REVOCATION_CERT=""
