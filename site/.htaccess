# Bitter Browser website (Apache on Hostinger).
Options -Indexes
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# The installer always comes from the latest signed release on GitHub.
Redirect 302 /install.sh https://github.com/bernardopg/bitter-browser/releases/latest/download/install.sh
Redirect 302 /download https://github.com/bernardopg/bitter-browser/releases/latest
Redirect 302 /bitter-browser-packages.asc https://github.com/bernardopg/bitter-browser/releases/latest/download/bitter-browser-packages.asc

<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "no-referrer"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self'; font-src 'self'; script-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'; form-action 'none'"
  <FilesMatch "\.(woff|svg|png|ico|css|js)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>
AddType font/woff .woff
AddType image/svg+xml .svg
